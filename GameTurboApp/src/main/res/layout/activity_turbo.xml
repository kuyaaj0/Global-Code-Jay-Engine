<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#111215"
    android:padding="0dp">

    <!-- LEFT NAVBAR (Engine Switcher Panel) -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#1A1C22"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GLOBAL JAY"
            android:textColor="#00FFCC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENGINE HUB"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"/>

        <!-- Navbar Button: Original FNF -->
        <Button
            android:id="@+id/btnOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Original FNF"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00FFCC"/> <!-- Neon active default -->

        <!-- Navbar Button: Psych Engine -->
        <Button
            android:id="@+id/btnPsych"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Psych Fork"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:backgroundTint="#2C2F38"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- RIGHT SETTINGS PANEL (Dynamically updates based on navbar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtEngineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Original FNF Configuration"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtEngineDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Standard unmodded ruleset. Optimized for low-end hardware paths."
            android:textColor="#777777"
            android:textSize="12sp"
            android:layout_marginBottom="24dp"/>

        <!-- Shared Core Toggles -->
        <CheckBox
            android:id="@+id/chkDownscroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Downscroll"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="12dp"/>

        <CheckBox
            android:id="@+id/chkMiddlescroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Middlescroll"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="12dp"/>

        <!-- Dynamic Psych Engine Exclusive Settings (Hidden by default for Original) -->
        <CheckBox
            android:id="@+id/chkModcharts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Execute Lua Modcharts (3D/4D Skews)"
            android:textColor="#888888"
            android:visibility="gone" 
            android:layout_marginBottom="12dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- LAUNCH CONTROLLER BUTTON -->
        <Button
            android:id="@+id/btnLaunch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="LAUNCH ACTIVE ENGINE TARGET"
            android:textColor="#111215"
            android:textStyle="bold"
            android:backgroundTint="#00FFCC"/>
    </LinearLayout>
</LinearLayout>

