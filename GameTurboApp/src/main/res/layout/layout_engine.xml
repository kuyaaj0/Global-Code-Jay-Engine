<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="20dp"
    android:layout_marginBottom="16dp">

    <!-- Section Title -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENGINE CONFIGURATION"
        android:textStyle="bold"
        android:textColor="#00E5FF"
        android:textSize="14sp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30343D"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"/>

    <!-- Current Engine -->

    <TextView
        android:id="@+id/txtEngineTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Original FNF Configuration"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/txtEngineDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Standard unmodded ruleset. Optimized for low-end hardware paths."
        android:textColor="#A5ADB8"
        android:textSize="13sp"
        android:layout_marginTop="8dp"/>

    <!-- Engine Information -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#181B20"
        android:padding="16dp"
        android:layout_marginTop="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENGINE DETAILS"
        android:textColor="#00E5FF"
        android:textStyle="bold"
        android:textSize="13sp"/>

    <ImageView
        android:id="@+id/imgEngineLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_fnf"/>

    <TextView
        android:id="@+id/txtSelectedEngine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selected Engine: FNF Vanilla"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/txtEngineVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version: v0.8.5"
        android:textColor="#DDDDDD"
        android:textSize="12sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/txtEnginePlatform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Platform: Android"
        android:textColor="#DDDDDD"
        android:textSize="12sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/txtEngineCompatibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Compatibility: Stable"
        android:textColor="#DDDDDD"
        android:textSize="12sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Features"
        android:textColor="#00E5FF"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginTop="12dp"/>
        
    <TextView
        android:id="@+id/txtEngineFeatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Basic Gameplay"
        android:textColor="#DDDDDD"
        android:textSize="12sp"
        android:layout_marginTop="4dp"/>
        
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notes"
        android:textColor="#00E5FF"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginTop="12dp"/>
        
    <TextView
        android:id="@+id/txtEngineNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Engine Notes"
        android:textColor="#DDDDDD"
        android:textSize="12sp"
        android:layout_marginTop="4dp"/>

</LinearLayout>

    <!-- Future Features -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upcoming Features"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Engine Profiles"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginTop="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Auto Detection"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Multi-Version Support"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Engine Diagnostics"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</LinearLayout>
