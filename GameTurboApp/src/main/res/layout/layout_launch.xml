<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#20242C"
    android:padding="20dp"
    android:layout_marginBottom="16dp">

    <!-- Title -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENGINE LAUNCHER"
        android:textStyle="bold"
        android:textColor="#00E5FF"
        android:textSize="14sp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30343D"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"/>

    <!-- Status Card -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#181B20"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Launch Status"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready to generate turbo_config.json and launch the selected engine."
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- Configuration Summary -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#181B20"
        android:padding="14dp"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Configuration"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engine selection, gameplay settings, and optimization options will be saved before launch."
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- Launch Button -->

    <Button
        android:id="@+id/btnLaunch"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:text="🚀 LAUNCH ENGINE"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#111215"
        android:backgroundTint="#00E5FF"/>

    <!-- Footer -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="../values/@string/engine_version"
        android:textColor="#666666"
        android:textSize="10sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"/>

</LinearLayout>
