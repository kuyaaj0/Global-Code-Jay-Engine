<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launchOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD000000"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/launchCard"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#20242C">

        <TextView
            android:id="@+id/txtLaunchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preparing Launch..."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtLaunchLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/txtLaunchLine2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/txtLaunchLine3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/txtLaunchLine4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/txtLaunchLine5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</FrameLayout>
