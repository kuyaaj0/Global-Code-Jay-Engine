<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardPerformance"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="20dp"
    android:layout_marginBottom="16dp">

    <!-- Title -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PERFORMANCE SETTINGS"
        android:textStyle="bold"
        android:textColor="#00E5FF"
        android:textSize="14sp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30343D"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"/>

    <!-- Mobile Optimization -->

    <CheckBox
        android:id="@+id/chkPerformanceMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enable Performance Mode"
        android:textColor="#FFFFFF"/>

    <CheckBox
        android:id="@+id/chkLowEndMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Low-End Device Optimization"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"/>

    <CheckBox
        android:id="@+id/chkMatrix4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Experimental Matrix4 Pipeline"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"/>

    <!-- Divider -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30343D"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"/>

    <!-- FPS Limit -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FPS LIMIT"
        android:textStyle="bold"
        android:textColor="#00E5FF"
        android:textSize="13sp"/>

    <Spinner
        android:id="@+id/spinnerFPS"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"/>

    <!-- Info Card -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#181B20"
        android:padding="12dp"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Optimization Notes"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Future versions will support Matrix4 note rendering, optimized modchart pipelines, memory caching, and mobile rendering improvements."
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</LinearLayout>
